# Development: Next.js talks to the independently running capture worker.
CAPTURE_WORKER_URL=http://127.0.0.1:8787
CAPTURE_WORKER_API_KEY=
# For docker compose, worker and web share this secret when provided.
CAPTURE_API_KEY=
# Set a strong password before exposing the frontend on the internet.
# Basic auth username can be anything. Use HTTPS outside localhost.
SITE_PASSWORD=
ENABLE_4K_VIDEO=false
